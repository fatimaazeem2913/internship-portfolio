# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file -- it should be listed in .gitignore.

# Your Gemini API key. Get a free one (no credit card required) at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-real-key-here

# Which Gemini model to use.
GEMINI_MODEL=gemini-3.5-flash-lite

# Set to "true" to run the entire app without any real API calls --
# uses deterministic mock responses instead, for offline development
# and testing. Set to "false" (or omit) to use the real Gemini API.
USE_MOCK_LLM=false
