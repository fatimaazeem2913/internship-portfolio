# Copy this file to .env.local and adjust if your backend runs on a
# different host/port. Vite only exposes env vars prefixed with VITE_
# to client-side code -- this is a deliberate security boundary, so
# server-only secrets (like GEMINI_API_KEY) can never accidentally leak
# into the browser bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000
